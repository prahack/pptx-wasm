{
  "name": "pptx-wasm",
  "version": "0.3.0",
  "description": "Browser-native, read-only .pptx renderer. Rust/WASM core, canvas output, no server-side conversion and nothing uploaded.",
  "keywords": [
    "pptx",
    "powerpoint",
    "presentation",
    "slides",
    "viewer",
    "renderer",
    "ooxml",
    "wasm",
    "webassembly",
    "rust",
    "canvas",
    "react"
  ],
  "license": "MIT",
  "author": "Prabhanu <prabhanu96@gmail.com>",
  "homepage": "https://github.com/prahack/pptx-wasm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prahack/pptx-wasm.git",
    "directory": "packages/viewer"
  },
  "bugs": {
    "url": "https://github.com/prahack/pptx-wasm/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./wasm": "./dist/pptx_bg.wasm"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "cp ../../CHANGELOG.md ./CHANGELOG.md && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
